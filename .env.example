# Copy to .env for local development only.
# In production these are set as environment variables in Coolify — never committed.

PORT=3000

# Random long string used to sign session cookies.
SESSION_SECRET=change-this-to-a-long-random-string

# Demo account (single account, used for the postoque.com feature preview).
DEMO_USER_EMAIL=zinergeco@gmail.com
# bcrypt hash of the demo password — generate with scripts/hash-password.js
DEMO_USER_PASSWORD_HASH=
