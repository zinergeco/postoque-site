<header class="site wrap">
  <div class="nav">
    <a class="brand" href="/">
      <span class="mark">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M4 12h6l2-5 4 10 2-5h2" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="wordmark">Posto<span>Que</span></span>
    </a>
    <div class="nav-right">
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle dark mode">
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      <% if (user) { %>
        <a class="btn gho sm" href="/dashboard">Dashboard</a>
        <form action="/logout" method="POST" style="display:inline">
          <button class="btn pri sm" type="submit">Log out</button>
        </form>
      <% } else { %>
        <a class="btn gho sm" href="/login">Login</a>
      <% } %>
    </div>
  </div>
</header>
